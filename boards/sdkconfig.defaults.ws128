# WS128 (Waveshare ESP32-S3-LCD-1.28 非触摸版) board overlay — build with (Docker):
#   idf.py -B build_ws128 -DSDKCONFIG=sdkconfig.ws128 \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/sdkconfig.defaults.ws128" set-target esp32s3 && build
# Hardware: ESP32-S3R2 (16MB Flash + 2MB Quad PSRAM), GC9A01 240x240 4-wire SPI, no touch.
CONFIG_OBD_BOARD_WS_128_GC9A01=y
# V1-only bring-up (RS485 / ADS1115) is compiled out on non-WS185 boards; the
# board's LCD_RST (GPIO12) also collides with the default RS485 RX pin.
CONFIG_OBD_HW_VERSION_V2_NEW=y
# 240 = panel native render (720-master UI folded down at compile time);
# replaces the former virtual-360 + flush downscale path entirely.
CONFIG_OBD_UI_RENDER_RES=240
# In-package PSRAM is Quad — the shared octal default fails to boot on this
# board ("octal_psram: PSRAM chip is not connected, or wrong PSRAM line mode").
CONFIG_SPIRAM_MODE_QUAD=y
# 2MB PSRAM 下启动链路(app_main + nvs/esp_lcd 初始化)顶到默认 3584 栈,
# 上下文切换时栈溢出挂掉;放宽 main 任务栈。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# No touch: the OTA page is unreachable, so the WiFi screen-capture
# hotspot must come up automatically at boot (OBD_SCREENSHOT is default y),
# and the control page doubles as a remote touchscreen (all gestures work
# through a virtual LVGL pointer device).
CONFIG_OBD_SCREENSHOT_AUTO_START=y
CONFIG_OBD_REMOTE_TOUCH=y
