# WS128T (Waveshare ESP32-S3-Touch-LCD-1.28 触摸版) board overlay — build with (Docker):
#   idf.py -B build_ws128t -DSDKCONFIG=sdkconfig.ws128t \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/sdkconfig.defaults.ws128t" set-target esp32s3 && build
# Hardware: ESP32-S3R2 (16MB Flash + 2MB Quad PSRAM), GC9A01 240x240 4-wire SPI,
# CST816S touch on shared I2C (SDA=6/SCL=7, RST=13/INT=5). LCD_RST=14 / BL=2 —
# 与非触摸版 WS128 不同,引脚细节见 boards/board_ws_128t_gc9a01_spec.h。
CONFIG_OBD_BOARD_WS_128T_GC9A01=y
# V1-only bring-up (RS485 / ADS1115) is compiled out on non-WS185 boards;
# 本板触摸引脚也与 V1 默认外设脚相邻,走 V2。
CONFIG_OBD_HW_VERSION_V2_NEW=y
# 240 = panel native render (720-master UI folded down at compile time);
# replaces the former virtual-360 + flush downscale path entirely.
CONFIG_OBD_UI_RENDER_RES=240
# In-package PSRAM is Quad — the shared octal default fails to boot on this
# board ("octal_psram: PSRAM chip is not connected, or wrong PSRAM line mode").
CONFIG_SPIRAM_MODE_QUAD=y
# 2MB PSRAM 下启动链路(app_main + nvs/esp_lcd 初始化)顶到默认 3584 栈,
# 上下文切换时栈溢出挂掉;放宽 main 任务栈。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 触摸板:真实触摸直达 UI(有触摸 indev,OTA 页可达),远程触摸与
# 开机自动热点均保持默认 n;需要远程查看时手动进 OTA 模式页开热点即可。
